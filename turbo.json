{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "packages/config/tsconfig.base.json",
    "packages/config/tsconfig.nextjs.json",
    "packages/config/tsconfig.worker.json"
  ],
  "globalPassThroughEnv": [
    "ABADGE_API_URL",
    "ABADGE_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "ENCRYPTION_KEY",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "SKIP_ENV_VALIDATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ABADGE_API_URL",
        "ABADGE_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL"
      ],
      "outputs": [".next/**", ".open-next/**", "dist/**"]
    },
    "@abadge/cli#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "@abadge/mcp#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "build:workers": {
      "env": [
        "ABADGE_API_URL",
        "ABADGE_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL"
      ],
      "outputs": [".next/**", ".open-next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:reset": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["@abadge/cli#build", "@abadge/mcp#build"],
      "passThroughEnv": ["TEST_DATABASE_URL", "E2E_DEBUG"]
    }
  }
}
