{
  "name": "@abadge/trpc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./react": {
      "types": "./src/react.tsx",
      "default": "./src/react.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./test-helpers": {
      "types": "./src/server/__tests__/helpers/index.ts",
      "default": "./src/server/__tests__/helpers/index.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test src/server/routers/ src/server/*.test.ts",
    "test:integration": "bun test src/server/__tests__/integration/",
    "test:e2e": "bun test src/server/__tests__/e2e/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@abadge/auth": "workspace:*",
    "@abadge/core": "workspace:*",
    "@abadge/crypto": "workspace:*",
    "@abadge/db": "workspace:*",
    "@abadge/env": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.8.0",
    "@trpc/tanstack-react-query": "^11.0.0",
    "effect": "^3.20.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
