{
  "name": "@abadge/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the abadge zero-knowledge vault API",
  "license": "MIT",
  "homepage": "https://github.com/punitarani/abadge#readme",
  "bugs": {
    "url": "https://github.com/punitarani/abadge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punitarani/abadge.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@abadge/core": "workspace:*",
    "@trpc/client": "^11.0.0"
  },
  "devDependencies": {
    "@trpc/server": "^11.0.0",
    "typescript": "^5.7.0"
  }
}
