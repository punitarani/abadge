{
  "name": "@abadge/mcp",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "bin": {
    "abadge-mcp": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun run --cwd ../sdk build && bun build --compile ./src/index.ts --outfile ./dist/abadge-mcp",
    "test": "bun test",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "@abadge/core": "workspace:*",
    "@abadge/crypto": "workspace:*",
    "@abadge/daemon": "workspace:*",
    "@abadge/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
