{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abadge-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.abadge.dev"
  }
}
