{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abadge-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "abadge.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
