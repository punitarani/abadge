{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abadge-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "abadge.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": [
      "ABADGE_API_URL",
      "ABADGE_APP_URL"
    ]
  }
}
