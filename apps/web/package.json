    "@tanstack/react-query-devtools": "^5.66.0",
    "@testing-library/react": "^16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "storybook": "^10.3.4",
    "typescript": "^5.7.0",
    "wrangler": "latest"
