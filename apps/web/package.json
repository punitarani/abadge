{
  "name": "@abadge/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "build:workers": "opennextjs-cloudflare build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "deploy": "bun run build:workers && bun ../../scripts/sync-worker-secrets.ts --config wrangler.jsonc && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@abadge/auth": "workspace:*",
    "@abadge/core": "workspace:*",
    "@abadge/crypto": "workspace:*",
    "@abadge/env": "workspace:*",
    "@abadge/trpc": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-query": "^5.66.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "latest",
    "next": "^15.3.0",
    "nuqs": "^2",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "latest",
    "@tanstack/react-query-devtools": "^5.66.0",
    "wrangler": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "shadcn": "^4.1.2",
    "typescript": "^5.7.0"
  }
}
