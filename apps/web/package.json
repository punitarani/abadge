{
  "name": "@abadge/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "build:workers": "opennextjs-cloudflare build",
