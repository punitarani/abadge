{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abadge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.abadge.io",
      "custom_domain": true
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  },
  "secrets": {
    "required": [
      "ABADGE_API_URL",
      "ABADGE_APP_URL",
      "BETTER_AUTH_SECRET",
      "ENCRYPTION_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
    ]
  },
  "placement": {
    "mode": "smart"
  },
  "send_email": [
    {
      // CF Email Workers binding. Domain: notifications.abadge.io
      // SPF/DKIM/DMARC configured on cf-bounce.notifications.abadge.io.
      // From-address: notifications@notifications.abadge.io
      "name": "SEND_EMAIL"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3ea93d0186d94581b5b66f4e670216bb",
      "localConnectionString": "postgresql://abadge:abadge@localhost:5432/abadge"
    }
  ],
  // §RL1-5: Durable Object rate-limit counter. Cross-isolate consistent
  // counter for the /api/auth (60/min) + /trpc (100/min) buckets.
  // See AGENTS.md "No Durable Objects" invariant — this binding is a
  // documented exception; rate-limit correctness requires cross-isolate
  // state and no simpler primitive provides it on Workers.
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMIT",
        "class_name": "RateLimitCounter"
      }
    ]
  },
  "migrations": [
    {
      // new_sqlite_classes (not new_classes): Cloudflare's 2024-onwards
      // recommendation for new DOs — SQLite-backed storage is cheaper and
      // the only supported option for new classes in the Workers free tier.
      "tag": "v1-rate-limit-counter",
      "new_sqlite_classes": ["RateLimitCounter"]
    }
  ]
}
