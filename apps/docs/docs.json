{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "abadge",
  "description": "Credential control plane for AI agents. Store secrets, scope agent access, control delivery, audit everything.",
  "colors": {
    "primary": "#0F172A",
    "light": "#3B82F6",
    "dark": "#0F172A"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/punitarani/abadge"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://abadge.io"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/punitarani/abadge"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "introduction",
              "why-abadge",
              "quickstart",
              "architecture"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/organizations",
              "concepts/profiles",
              "concepts/items",
              "concepts/agents",
              "concepts/permissions-and-capabilities",
              "concepts/fields",
              "concepts/audit-log"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "security/overview",
              "security/zero-knowledge",
              "security/trust-boundaries"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "workflows/flows"
            ]
          },
          {
            "group": "Migration",
            "pages": [
              "migration/v0-to-v1"
            ]
          }
        ]
      },
      {
        "tab": "Dashboard",
        "groups": [
          {
            "group": "Using the dashboard",
            "pages": [
              "dashboard/overview",
              "dashboard/signing-in",
              "dashboard/organizations",
              "dashboard/profiles",
              "dashboard/items",
              "dashboard/agents",
              "dashboard/permissions",
              "dashboard/audit",
              "dashboard/vault-security"
            ]
          }
