{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "abadge",
  "description": "Credential control plane for AI agents. Store secrets, scope agent access, control delivery, audit everything.",
  "colors": {
    "primary": "#0F172A",
    "light": "#3B82F6",
    "dark": "#0F172A"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/punitarani/abadge"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://abadge.io"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/punitarani/abadge"
    }
  },
