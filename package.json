{
  "name": "abadge",
  "private": true,
  "packageManager": "bun@1.3.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "doppler run -- turbo dev",
    "build": "turbo build",
    "lint": "biome check apps/ packages/ scripts/ apps/web/.storybook/",
    "lint:fix": "biome check --write apps/ packages/ scripts/ apps/web/.storybook/",
    "format": "biome format --write apps/ packages/ scripts/ apps/web/.storybook/",
    "typecheck": "turbo typecheck",
    "auth:migrate": "doppler run -- bunx @better-auth/cli migrate",
    "db:generate": "doppler run -- turbo db:generate --filter=@abadge/db",
    "db:migrate": "doppler run -- turbo db:migrate --filter=@abadge/db",
    "db:push": "doppler run -- turbo db:push --filter=@abadge/db",
    "db:studio": "doppler run -- turbo db:studio --filter=@abadge/db",
    "db:reset": "doppler run -- turbo db:reset --filter=@abadge/db",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "dev:vars": "doppler run -- bash scripts/generate-dev-vars.sh",
    "api:dev:worker": "bun run dev:vars && cd apps/api && bunx wrangler dev --local --no-live-reload",
    "api:clean:worker": "rm -rf apps/api/.wrangler",
    "cli": "bun packages/cli/bin/abadge.ts",
    "mcp": "doppler run -- bun packages/mcp/src/index.ts",
    "storybook": "bun run --cwd apps/web storybook",
    "storybook:build": "bun run --cwd apps/web storybook:build",
    "test:scripts": "bun test scripts",
    "test": "turbo test && bun run test:scripts",
    "test:e2e": "turbo test:e2e --filter=@abadge/e2e",
    "test:cov:unit": "bun scripts/coverage/run.ts unit",
    "test:cov:integration": "bun scripts/coverage/run.ts integration",
    "test:cov": "bun run test:cov:unit && bun run test:cov:integration",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:publish": "bun scripts/releases/publish.ts",
    "release:cli": "bun scripts/releases/publish.ts --package cli",
    "release:cli:dry-run": "bun scripts/releases/publish.ts --dry-run --package cli",
    "release:mcp": "bun scripts/releases/publish.ts --package mcp",
    "release:mcp:dry-run": "bun scripts/releases/publish.ts --dry-run --package mcp"
  },
  "overrides": {
    "drizzle-orm": "0.45.2",
    "better-auth": "1.5.6",
    "@better-auth/core": "1.5.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@better-auth/cli": "1.4.22",
    "@better-auth/core": "1.5.6",
    "@biomejs/biome": "latest",
    "@tanstack/react-query": "^5.66.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@trpc/tanstack-react-query": "^11.0.0",
    "@types/bun": "^1.3.11",
    "better-auth": "1.5.6",
    "effect": "^3.13.7",
    "turbo": "latest",
    "typescript": "^5.7.0"
  }
}
